# ===========================================
# Fast API Micro - Kubernetes Deployment Env
# ===========================================
# Copy relevant sections to individual service .env.deployment files
# or use kubectl set env to override at deployment time
# ===========================================

# ==================== Common for ALL services ====================
SECRET_KEY=d2bcbac0d9e7f5ffaf6b0fd44d8042f7fd438d7b24ec5e2f31e3c74a6233bcf9
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Kubernetes DNS names (automatically set if using kubectl)
POSTGRES_SERVICE=${POSTGRES_HOST:-postgres}
AUTH_SERVICE=${AUTH_SERVICE:-auth-service}
RABBITMQ_SERVICE=${RABBITMQ_HOST:-rabbitmq}
UPLOAD_SERVICE=${UPLOAD_SERVICE:-upload-service}

# ==================== auth-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/auth_service?sslmode=disable

# ================ Email Settings (set via Secrets or env override) ===============
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=mahidulmoon@gmail.com
# EMAIL_PASSWORD=<change from deployment secrets>
# RABBITMQ_URL=amqp://user:password@${RABBITMQ_SERVICE}:5672/

# ==================== post-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/post_db?sslmode=disable
AUTH_VALIDATOR=http://${AUTH_SERVICE}:8000/api/auth/verify_authentication

# ==================== chat-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/chat_db?sslmode=disable
AUTH_VALIDATOR=http://${AUTH_SERVICE}:8000/api/auth/verify_authentication

# ==================== marketplace-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/marketplace_db?sslmode=disable
AUTH_VALIDATOR=http://${AUTH_SERVICE}:8000/api/auth/verify_authentication

# ==================== notification-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/notification_db?sslmode=disable
AUTH_VALIDATOR=http://${AUTH_SERVICE}:8000/api/auth/verify_authentication
RABBITMQ_URL=amqp://user:password@${RABBITMQ_SERVICE}:5672/

# ==================== upload-service specific ====================
DATABASE_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/upload_db?sslmode=disable
AUTH_VALIDATOR=http://${AUTH_SERVICE}:8000/api/auth/verify_authentication
BASE_URL=http://${UPLOAD_SERVICE}:8086
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10

# ==================== worker specific ====================
# Same as above services, set AUTH_DB_URL instead of DATABASE_URL
AUTH_DB_URL=postgresql://user:secret@${POSTGRES_SERVICE}:5432/auth_service?sslmode=disable
RABBITMQ_URL=amqp://user:password@${RABBITMQ_SERVICE}:5672/
